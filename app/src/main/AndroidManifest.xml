<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internet permission required to call the Songlink API -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SonglinkShare"
        android:networkSecurityConfig="@xml/network_security_config">

        <!--
            MainActivity serves two roles:
            1. A standalone launcher activity (MAIN/LAUNCHER intent filter)
            2. A share target that receives ACTION_SEND text/plain intents from
               music apps (Spotify, YouTube Music, Apple Music, Tidal, etc.)

            When launched via share sheet, the activity reads the shared URL from
            the intent and immediately begins the Songlink API lookup.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">

            <!-- Standard launcher entry point -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Share intent filter — this makes the app appear in the Android
                share sheet when another app shares plain text (which is how
                music apps share their track links).

                android:label sets the name shown in the share sheet.
            -->
            <intent-filter android:label="@string/share_target_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>

</manifest>
